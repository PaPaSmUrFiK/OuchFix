# Локальный запуск без Docker: cp .env.example .env, Postgres на localhost:5433
# (docker compose up -d postgres), затем go run ./cmd/<сервис> для каждого сервиса.

# --- общее ---
LOG_LEVEL=info
# Часовой пояс медцентра (IANA): в нём считаются границы дня для freeSlots
# и отдаётся время в ответах сервисов.
APP_TIMEZONE=Europe/Minsk

# --- gateway (без доступа к БД, только базовые адреса сервисов) ---
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_SERVICES_TIMEOUT=5s
# ВРЕМЕННО до ЛР5: пользователь для myAppointments/myNotifications (5 — пациент из сида).
GATEWAY_TEST_USER_ID=5
IAM_BASE_URL=http://localhost:8081
CATALOG_BASE_URL=http://localhost:8082
APPOINTMENT_BASE_URL=http://localhost:8083
PAYMENT_BASE_URL=http://localhost:8084
NOTIFICATION_BASE_URL=http://localhost:8085

# --- порты сервисов ---
IAM_PORT=8081
CATALOG_PORT=8082
APPOINTMENT_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_PORT=8085

# --- postgres ---
# Администратор (только для init.sql и DBeaver): ouchfix / ouchfix, БД ouchfix.
# У каждого сервиса свой пользователь с правами только на свою схему.
IAM_POSTGRES_DSN=postgres://ouchfix_iam:ouchfix_iam@localhost:5433/ouchfix?sslmode=disable
CATALOG_POSTGRES_DSN=postgres://ouchfix_catalog:ouchfix_catalog@localhost:5433/ouchfix?sslmode=disable
APPOINTMENT_POSTGRES_DSN=postgres://ouchfix_appointment:ouchfix_appointment@localhost:5433/ouchfix?sslmode=disable
PAYMENT_POSTGRES_DSN=postgres://ouchfix_payment:ouchfix_payment@localhost:5433/ouchfix?sslmode=disable
NOTIFICATION_POSTGRES_DSN=postgres://ouchfix_notification:ouchfix_notification@localhost:5433/ouchfix?sslmode=disable
# Необязательно, значения по умолчанию: MAX_OPEN_CONNS=10, MAX_IDLE_CONNS=10,
# MAX_LIFETIME=5m, MAX_IDLE_TIME=1m. Пример: CATALOG_POSTGRES_MAX_OPEN_CONNS=20
