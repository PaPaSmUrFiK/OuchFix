# --- общее ---
LOG_LEVEL=info

# --- gateway ---
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s

# --- postgres ---
# У каждого сервиса своя БД (database-per-service). Локально можно указать одну
# и ту же базу: таблицы всё равно разнесены по схемам iam/catalog/appointment/...
IAM_POSTGRES_DSN=postgres://ouchfix:ouchfix@localhost:5432/ouchfix?sslmode=disable
CATALOG_POSTGRES_DSN=postgres://ouchfix:ouchfix@localhost:5432/ouchfix?sslmode=disable
APPOINTMENT_POSTGRES_DSN=postgres://ouchfix:ouchfix@localhost:5432/ouchfix?sslmode=disable
PAYMENT_POSTGRES_DSN=postgres://ouchfix:ouchfix@localhost:5432/ouchfix?sslmode=disable
NOTIFICATION_POSTGRES_DSN=postgres://ouchfix:ouchfix@localhost:5432/ouchfix?sslmode=disable
# Необязательно, значения по умолчанию: MAX_OPEN_CONNS=10, MAX_IDLE_CONNS=10,
# MAX_LIFETIME=5m, MAX_IDLE_TIME=1m. Пример: CATALOG_POSTGRES_MAX_OPEN_CONNS=20
